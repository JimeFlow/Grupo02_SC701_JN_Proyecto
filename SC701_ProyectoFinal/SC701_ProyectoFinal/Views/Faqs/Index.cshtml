@model List<SC701_ProyectoFinal.Models.FAQViewModel>

<h2>Preguntas Frecuentes</h2>

@foreach (var faq in Model)
{
    <div class="card mb-2">
        <div class="card-header fw-bold">
            @faq.Pregunta
        </div>
        <div class="card-body">
            @faq.Respuesta
        </div>
    </div>
}