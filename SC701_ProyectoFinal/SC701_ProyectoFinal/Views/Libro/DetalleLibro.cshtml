@model SC701_ProyectoFinal.Models.LibroViewModel

@{
    ViewData["Title"] = "Detalle del Libro";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h2>@Model.Titulo</h2>

<div>
    <p class="text-center">
        @if (!string.IsNullOrEmpty(Model.Imagen))
        {
            <img src="@Model.Imagen" alt="Portada" width="50" height="70" class="rounded shadow-sm" />
        }
        else
        {
            <span class="text-muted">Sin imagen</span>
        }
    </p>
    <p><strong>Autor:</strong> @Model.Autor || <strong>Año:</strong> @Model.AnioPublicacion  || <strong>ISBN:</strong> @Model.ISBN</p>
    <p><strong>Descripción:</strong> @Model.Descripcion</p>
    <p><strong>Estado:</strong> @Model.Estado</p>
</div>

<hr />

@* Boton de Reserva *@
<form asp-action="Reservar" method="post">
    <input type="hidden" name="idLibro" value="@Model.Id_Libro" />
    <button type="submit" class="btn btn-primary">Reservar</button>
</form>

<hr />

<h3>Comentarios y Calificaciones</h3>
@if (TempData["MensajeComentario"] != null)
{
    <div class="alert alert-info alert-success">
        @TempData["MensajeComentario"]
    </div>
}
@if (TempData["ErrorComentario"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorComentario"]
    </div>
}
<form asp-action="Crear" asp-controller="Comentarios" method="post">
    <input type="hidden" name="idEjemplar" value="@Model.Id_Ejemplar" />
    <input type="hidden" name="idLibro" value="@Model.Id_Libro" />

    <div class="form-group">
        <label>Comentario:</label>
        <textarea class="form-control" name="comentario" required></textarea>
    </div>

    <div class="form-group">
        <label>Calificación:</label>
        <select class="form-control" name="rating" required>
            <option value="">Seleccione</option>
            @for (int i = 1; i <= 5; i++)
            {
                <option value="@i">@i</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success mt-2">
        Agregar Comentario
    </button>
</form>

<hr />

@if (Model.Comentarios != null && Model.Comentarios.Any())
{
    foreach (var ComentarioModel in Model.Comentarios)
    {
        <div class="card mb-2">
            <div class="card-body">
                <strong>
                    @ComentarioModel.NombreUsuario
                </strong> - @ComentarioModel.FechaCreacion.ToShortDateString()<br />
                <span>
                    @ComentarioModel.Comentario
                </span>
                <span>
                    Calificación: @ComentarioModel.Rating ★
                </span>
            </div>
        </div>
    }
}
else
{
    <p>Este libro aún no tiene comentarios. </p>
}

<a asp-action="Index" class="btn btn-secondary">Volver a la lista de libros</a>
