@model IEnumerable<SC701_ProyectoFinal.Models.CategoriaModel>
@{
	Layout = "_LayoutInterno";
}

<div class="container mt-4">

    @* <div class="row">
        <div class="col-6">
            <div class="card"></div>
        </div>
        <div class="col-6">
            <div class="card"></div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-12">
            <div class="card"></div>
        </div>
    </div> *@

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-tags-fill"></i> Categorías
        </h2>

        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
            <i class="bi bi-plus-circle-fill"></i> Agregar Categoría
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No hay categorías registradas.
        </div>
    }
    else
    {
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-primary text-center">
                @ViewBag.Mensaje
            </div>
        }

        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Tipo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id_Categoria</td>
                            <td>@item.Tipo</td>

                            <td class="text-center">

                                <button class="btn btn-sm btn-outline-primary me-1"
                                        onclick="AbrirModalEditar(@item.Id_Categoria, '@item.Tipo')">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button class="btn btn-sm btn-danger"
                                        onclick="EliminarCategoria(@item.Id_Categoria)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL CREAR -->
<div class="modal fade" id="modalCrear" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formAgregarCategoria" asp-action="AgregarCategoria" asp-controller="Categoria" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Categoría</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <input name="Tipo" class="form-control" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- MODAL EDITAR -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditarCategoria" asp-controller="Categoria" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Categoría</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="editId" name="Id_Categoria" />

                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <input id="editTipo" name="Tipo" class="form-control" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    // Abrir modal editar con datos cargados

    function AbrirModalEditar(id, tipo) {
        document.getElementById("editId").value = id;
        document.getElementById("editTipo").value = tipo;

        var modal = new bootstrap.Modal(document.getElementById('modalEditar'));
        modal.show();
    }

    // SweetAlert para eliminar
    function EliminarCategoria(id) {
        Swal.fire({
            title: "¿Eliminar categoría?",
            text: "Esta acción no se puede deshacer.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Categoria/EliminarCategoria/" + id;
            }
        });
    }
</script>