@model SC701_ProyectoFinal.Models.LibroModel

@{
    ViewData["Title"] = "Registrar Libro";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Registrar Nuevo Libro</h2>

    <div class="card shadow-lg">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Titulo" class="form-label fw-bold">Título</label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ingrese el título del libro" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Autor" class="form-label fw-bold">Autor</label>
                        <input asp-for="Autor" class="form-control" placeholder="Nombre del autor" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="ISBN" class="form-label fw-bold">ISBN</label>
                        <input asp-for="ISBN" class="form-control" placeholder="Ejemplo: 978-84-376-0494-7" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Categoría</label>
                        <select class="form-select" asp-for="Id_Categoria"
                                asp-items="@(new SelectList(ViewBag.Categorias, "Id_Categoria", "Tipo"))">
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Anio" class="form-label fw-bold">Año</label>
                        <input asp-for="Anio" class="form-control" type="number" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                        <input asp-for="Descripcion" class="form-control" type="text" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Imagen_URL" class="form-label fw-bold">URL Imagen</label>
                    <input asp-for="Imagen_URL" class="form-control" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Volver</a>
                </div>
            </form>
        </div>
    </div>


</div>

