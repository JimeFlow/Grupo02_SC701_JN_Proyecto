@model SC701_ProyectoFinal.Models.LibroModel

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Editar Libro</h2>

    <div class="card shadow-lg">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id_Libro" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Titulo" class="form-label fw-bold">Título</label>
                        <input asp-for="Titulo" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Autor" class="form-label fw-bold">Autor</label>
                        <input asp-for="Autor" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="ISBN" class="form-label fw-bold">ISBN</label>
                        <input asp-for="ISBN" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Categoría</label>
                        <select asp-for="Id_Categoria" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Categorias, "Id_Categoria", "Tipo", Model.Id_Categoria))">
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Anio" class="form-label fw-bold">Año</label>
                        <input asp-for="Anio" class="form-control" type="number" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                        <input asp-for="Descripcion" class="form-control" type="text" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Imagen_URL" class="form-label fw-bold">URL de la Imagen</label>
                    <input asp-for="Imagen_URL" class="form-control" />
                </div>

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Volver</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const select = document.getElementById('Id_Estado');
        const hidden = document.getElementById('Estado_Libro');
            // Inicializar el hidden al cargar la página
            hidden.value = select.options[select.selectedIndex].text;

            // Actualizar el Estado_Libro según la selección
            select.addEventListener('change', function() {
                hidden.value = select.options[select.selectedIndex].text;
            });
    </script>

}
