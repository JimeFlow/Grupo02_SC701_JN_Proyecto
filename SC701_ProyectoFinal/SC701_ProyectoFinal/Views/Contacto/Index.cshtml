@model SC701_ProyectoFinal.Models.ContactoViewModel
@{
    ViewData["Title"] = "Contacto";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-envelope-fill me-2"></i>
                        Contáctanos
                    </h4>
                </div>

                <div class="card-body">

                    <p class="text-muted mb-4">
                        ¿Tienes alguna duda o consulta sobre el uso de la biblioteca?
                        Escríbenos y un administrador te responderá lo antes posible.
                    </p>

                    @if (TempData["MensajeExito"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["MensajeExito"]
                        </div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Enviar" method="post">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre</label>
                                <input asp-for="Nombre" class="form-control" required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Correo electrónico</label>
                                <input asp-for="Correo" type="email" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Asunto</label>
                            <input asp-for="Asunto" class="form-control" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Mensaje</label>
                            <textarea asp-for="Mensaje"
                                      class="form-control"
                                      rows="5"
                                      required></textarea>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send me-1"></i>
                                Enviar mensaje
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>