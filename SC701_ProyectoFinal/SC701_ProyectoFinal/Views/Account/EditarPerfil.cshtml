@model SC701_ProyectoFinal.Models.UsuarioModel

@{
    ViewData["Title"] = "EditarPerfil";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary fw-bold">Editar Perfil</h2>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-info">@ViewBag.Mensaje</div>
    }

    <form id="formPerfil" asp-action="EditarPerfil" novalidate>        

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label fw-semibold"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Apellidos" class="form-label fw-semibold"></label>
            <input asp-for="Apellidos" class="form-control" />
            <span asp-validation-for="Apellidos" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Identificacion" class="form-label fw-semibold"></label>
            <input asp-for="Identificacion" class="form-control" />
            <span asp-validation-for="Identificacion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo" class="form-label fw-semibold"></label>
            <input asp-for="Correo" class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefono" class="form-label fw-semibold"></label>
            <input asp-for="Telefono" class="form-control" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Tipo_Rol" class="form-label fw-semibold"></label>
            <input asp-for="Tipo_Rol" class="form-control" readonly />
        </div>

        <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary ms-2">Volver</a>

    </form>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $("#formPerfil").validate({
            rules: {
                Nombre: { required: true, minlength: 2 },
                Apellidos: { required: true, minlength: 2 },
                Correo: { required: true, email: true },
                Identificacion: { required: true, minlength: 9, maxlength: 9 },
                Telefono: { required: true, minlength: 8, maxlength: 15 }
            },
            messages: {
                Nombre: "Ingrese un nombre válido.",
                Apellidos: "Ingrese apellidos válidos.",
                Correo: "Ingrese un correo válido.",
                Identificacion: "La identificación debe tener 9 dígitos.",
                Telefono: "Número de teléfono inválido."
            },
            errorClass: "text-danger",
            validClass: "is-valid"
        });
    </script>
}
