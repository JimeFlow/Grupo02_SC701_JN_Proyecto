@model IEnumerable<SC701_ProyectoFinal.Models.UsuarioModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-people-fill"></i> Lista de Usuarios
        </h2>

        <a asp-action="RegistrarUsuarioAdmin" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Crear Usuario
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No hay usuarios registrados.
        </div>
    }
    else
    {
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-primary text-center">
                @ViewBag.Mensaje
            </div>
        }
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Nombre</th>
                        <th>Identificación</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th>Rol</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre @item.Apellidos</td>
                            <td>@item.Identificacion</td>
                            <td>@item.Correo</td>
                            <td>@item.Telefono</td>

                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">@item.Tipo_Rol</span>
                            </td>

                            <td class="text-center">
                                <a class="btn btn-sm btn-outline-primary me-1" asp-action="EditarUsuario" asp-route-id="@item.Id_Usuario">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button class="btn btn-sm btn-danger" onclick="EliminarUsuario(@item.Id_Usuario)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<script>
    function EliminarUsuario(id) {
        Swal.fire({
            title: "¿Eliminar usuario?",
            text: "Esta acción no se puede deshacer",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Usuario/EliminarUsuario/" + id;
            }
        });
    }
</script>
