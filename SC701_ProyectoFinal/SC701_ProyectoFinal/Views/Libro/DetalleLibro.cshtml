<hr/>

<h3 id="comentarios" class="mt-4">Comentarios y Calificaciones</h3>
@if(TempData["MensajeComentario"] != null)
{
    <div class="alert alert-success">@TempData["MensajeComentario"] </div>
}
@if(TempData["ErrorComentario"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorComentario"] </div>
}

<form asp-action="AgregarComentario" method="post" asp-controller="Libro" class="mt-3 mb-4">
    <input type="hidden" name="LibroId" value="@Model.LibroId" />


    <div class="mb-3">
    <label>Comentario:</label>
    <textarea class="form-control" name="Comentario" required></textarea>
	</div>

    <div class="mb-3">
    <label>Calificación:</label>
    <select class="form-control" name="Rating" required>
        <option value="">Seleccione</option>
        @for (int i = 1; i <= 5; i++)
        {
            <option value="@i">@i ★</option>
        }
    </select>
    </div>

    <button type="submit" class="btn btn-success mt-3">Agregar Comentario</button>
</form>

<hr />

@if (Model.Comentarios != null && Model.Comentarios.Any())
{
    foreach (var c in Model.Comentarios)
    {
        <div class="card mb-3">
            <div class="card-body">
                <strong>@c.NombreUsuario</strong> — @c.FechaCreacion.ToShortDateString() <br />
                <p>@c.Comentario</p>
                <span class="text-warning">Calificación: @c.Rating ★</span>
            </div>
        </div>
    }
}
else
{
    <p>No hay comentarios para este libro todavía.</p>
}