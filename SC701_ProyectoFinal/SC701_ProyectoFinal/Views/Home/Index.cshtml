@model IEnumerable<SC701_ProyectoFinal.Models.LibroModel>
@{
    Layout = "_LayoutInterno";
}
<!-- ============================================-->
<!-- Preloader ==================================-->
<div class="preloader" id="preloader">
    <div class="loader">
        <div class="line-scale-pulse-out-rapid">
            <div> </div>
            <div></div>
            <div></div>
            <div></div>
            <div> </div>
        </div>
    </div>
</div>
<!-- ============================================-->
<!-- End of Preloader ===========================-->
<!-- ============================================-->
<!-- <section> begin ============================-->
<section class="py-lg-7 py-xl-8 mt-5 bg-light" id="ecommerceHeader">

    <div class="container-fluid">
        <div class="row">
            <div class="offset-xl-3 col px-4" style="max-width: 42.81rem">
                <h1 class="display-4 fs-6 fs-sm-5 fs-md-4">Impulsando el<span class="font-base fst-italic fw-normal px-2 px-md-3">conocimiento</span> <br class="d-none d-sm-block" />desde 1987</h1>
                <p class="mt-4 mb-0">Todos nuestros productos están pensados para ofrecerte un acesso rápido, confiable y organizado a todo el conocimiento que necesitas. Nos enfocamos en la calidad, precisión y la comodidad, 
                    brindándote una experiencia moderna de búsqueda, reserva y compra.</p>
            </div>
        </div>
    </div>
    <!-- end of .container-->

</section>
<!-- <section> close ============================-->
<!-- ============================================-->
<!-- ============================================-->
<!-- <section> begin ============================-->
<section class="py-0" id="ecommerceProducts">

    <div class="container-fluid px-4">
        <div class="row mb-5">
            
            @foreach (var libro in Model.Take(4))
            {
                <div class="col-sm-6 col-md-4 col-lg-3 mt-4">
                    <div class="row g-0">

                        <!-- Imagen -->
                        <div class="col-12 overflow-hidden rounded">
                            <div class="row">
                                <div class="col">
                                    <div class="swiper theme-slider swiper-theme"
                                         data-swiper='{"loop":true,"effect":"fade",
                                             "pagination":{"el":".swiper-pagination","clickable":true,"type":"bullets"}}'>

                                        <div class="swiper-wrapper">
                                            <div class="swiper-slide">
                                                <a href="#">
                                                    <img class="h-100 w-100"
                                                         src="@libro.Imagen_URL"
                                                         alt="@libro.Titulo" />
                                                </a>
                                            </div>
                                        </div>

                                        
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Texto -->
                        <a class="col-12 mt-2" href="#">
                            <h5 class="fs-9">@libro.ISBN - @libro.Titulo</h5>
                        </a>

                        <div class="col-12">
                            <h6 class="fw-normal mb-0 d-inline-block">Autor: @libro.Autor</h6>
                        </div>

                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="text-center mt-5">
                    <h5>No hay libros registrados.</h5>
                </div>
            }

            <div class="align-items-center justify-content-center d-flex mt-5">
                <button class="btn btn-light">Ver todos</button>
            </div>
        </div>
    </div>
    <!-- end of .container-->

</section>
<!-- <section> close ============================-->
<!-- ============================================-->
<!-- ============================================-->
<!-- <section> begin ============================-->
<section class="text-center bg-light pt-6 pt-lg-8 pb-0 pb-sm-5 pb-lg-8" id="ecommerceSubscribe">

    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <a href="#!">
                    <h5 class="fw-normal mb-3 text-uppercase text-center ls-2">Siguenos</h5>
                </a>
            </div>
            <div class="w-100"></div>
            <div class="col-lg-6 pe-xl-4">
                <div class="row g-2" id="ecommerce-gallery">
                    <div class="col-6">
                        <a href="#!" data-bp="~/lib/img/principito.jpg" data-bigpicture='{"gallery":"#ecommerce-gallery"}' data-caption="your caption"><img class="rounded img-fluid" src="~/lib/img/principito.jpg" alt="" data-zanim-xs='{"delay":0.1,"animation":"zoom-in"}' data-zanim-trigger="scroll" /></a>
                    </div>
                    <div class="col-6">
                        <a href="#!" data-bp="~/lib/img/Don.jpg" data-bigpicture='{"gallery":"#ecommerce-gallery"}' data-caption="your caption"><img class="rounded img-fluid" src="~/lib/img/Don.jpg" alt="" data-zanim-xs='{"delay":0,"animation":"zoom-in"}' data-zanim-trigger="scroll" /></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="bg-body rounded border border-dark p-4 p-sm-6 p-lg-5 p-xl-6 mt-7 mt-lg-0">
                    <h4 class="mb-3 fw-bold">Regístrate y recibe ofertas increíbles<span class="font-base fst-italic"> </span>
                    </h4>
                    <div class="input-group mb-3">
                        <input class="form-control bg-light" type="text" placeholder="Ingrese su correo aquí" aria-label="Recipient's username" aria-describedby="button-addon-e" />
                        <button class="btn btn-dark btn-outline-dark text-light px-2 px-sm-3 px-lg-4" id="button-addon-e" type="button">suscribirse</button>
                    </div>
                    <h6 class="fw-normal text-body">Nosotros respetamos tu privacidad</h6>
                </div>
            </div>
        </div>
    </div>
    <!-- end of .container-->

</section>
<!-- <section> close ============================-->
<!-- ============================================-->
<!-- ============================================-->
<!-- <section> begin ============================-->


    
    <!-- end of .container-->


<!-- <section> close ============================-->
<!-- ============================================-->