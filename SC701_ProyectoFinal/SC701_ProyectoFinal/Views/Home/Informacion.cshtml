@model SC701_ProyectoFinal.Models.InformacionViewModel

@{
    ViewData["Title"] = "Información";

    var rol = Context.Session.GetInt32("Id_Rol");

    Layout = rol == null
    ?"~/Views/Shared/_LayoutExterno.cshtml"
    : "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="container my-5">

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success text-center mb-4">
            @TempData["MensajeExito"]
        </div>
    }

    <!-- TÍTULO -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">Biblioteca Digital</h2>
        <p class="text-muted">
            Plataforma para la gestión y consulta de recursos bibliográficos
        </p>
    </div>

    <!-- DESCRIPCIÓN -->
    <div class="row mb-5">
        <div class="col-md-10 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="mb-0 text-center">
                        @Model.Texto
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- MISIÓN / VISIÓN -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">🎯 Misión</h5>
                    <p>
                        Brindar acceso organizado y confiable a los recursos bibliográficos,
                        apoyando la educación mediante herramientas digitales.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold">👁️ Visión</h5>
                    <p>
                        Ser una biblioteca moderna y accesible, que integre herramientas
                        tecnológicas para mejorar la experiencia de los usuarios y la gestión
                        eficiente de la información.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- SERVICIOS -->
    <div class="row mb-5">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">📚 Servicios disponibles</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Consulta de libros</li>
                        <li class="list-group-item">Reservas y préstamos</li>
                        <li class="list-group-item">Gestión de usuarios</li>
                        <li class="list-group-item">Comentarios y calificaciones</li>
                        <li class="list-group-item">Preguntas frecuentes</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- HORARIO -->
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm border-start border-4 border-primary">
                <div class="card-body">
                    <h5 class="fw-bold">⏰ Horario de atención</h5>
                    <p class="mb-0">@Html.Raw(Model.Horario.Replace("\n", "<br/>"))</p>
                </div>
            </div>
        </div>
    </div>

    @if (Context.Session.GetInt32("Id_Rol") == 1)
    {
        <div class="text-end mt-4">
            <a asp-controller="Home"
               asp-action="EditarInformacion"
               class="btn btn-outline-warning">
                <i class="bi bi-pencil-square me-1"></i>
                Editar información
            </a>
        </div>
    }



</div>