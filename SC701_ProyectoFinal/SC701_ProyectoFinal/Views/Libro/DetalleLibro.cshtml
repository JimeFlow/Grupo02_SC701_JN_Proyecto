@model SC701_ProyectoFinal.Models.LibroViewModel

@{
    ViewData["Title"] = "Detalle del Libro";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<i class="bi bi-star-fill text-warning"></i>
<i class="bi bi-star"></i>

<h2 class="mb-4">@Model.Titulo</h2>

<div class="row mb-4">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.Imagen_URL))
        {
            <img src="@Model.Imagen_URL"
                 alt="Portada"
                 width="180"
                 class="rounded shadow-sm mb-3" />
        }
        else
        {
            <span class="text-muted">Sin imagen</span>
        }
    </div>

    <div class="col-md-8">
        <p>
            <strong>Autor:</strong> @Model.Autor |
            <strong>Año:</strong> @Model.AnioPublicacion |
            <strong>ISBN:</strong> @Model.ISBN
        </p>

        <p>
            <strong>Descripción:</strong><br />
            @Model.Descripcion
        </p>

        <!-- Botón Reservar -->
        <form asp-controller="Reserva"
              asp-action="CrearReserva"
              method="post"
              class="mt-3">
            <input type="hidden" name="Id_Ejemplar" value="@Model.Id_Ejemplar" />

            <button type="submit" class="btn btn-primary">
                Reservar
            </button>
        </form>
    </div>
</div>

<!-- ================= COMENTARIOS ================= -->

<div class="card-header bg-dark text-white">
    <h3 class="text-light fw-bold mb-0">
        <i class="bi bi-chat-left-text me-2"></i>
        Comentarios y Calificaciones
    </h3>
</div>

    <div class="card-body">

        @* Mensajes *@
        @if (TempData["MensajeComentario"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeComentario"]
            </div>
        }

        @if (TempData["ErrorComentario"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorComentario"]
            </div>
        }

        @* Formulario solo para usuarios *@
        @if (Context.Session.GetInt32("Id_Rol") == 2)
        {
            <form asp-action="Crear" asp-controller="Comentarios" method="post">
                <input type="hidden" name="Id_Ejemplar" value="@Model.Id_Ejemplar" />
            <input type="hidden" name="Id_Libro" value="@Model.Id_Libro" />

                <div class="form-group">
                    <label>Comentario:</label>
                    <textarea class="form-control" name="Comentario" required></textarea>
                </div>

                <div class="form-group">
                    <label>Calificación:</label>
                    <select class="form-control" name="Rating" required>
                        <option value="">Seleccione</option>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-success mt-2">
                    Agregar Comentario
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-warning">
                Debes iniciar sesión como usuario para dejar un comentario.
            </div>
        }

        @* Lista de comentarios *@
        @if (Model.Comentarios != null && Model.Comentarios.Any())
        {
            foreach (var comentario in Model.Comentarios)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <strong>@comentario.NombreUsuario</strong>
                        <span class="text-muted">
                            - @comentario.FechaCreacion.ToShortDateString()
                        </span>

                        <p class="mt-2 mb-1">
                            @comentario.Comentario
                        </p>

                        <div class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= comentario.Rating)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
        @if (Model.Comentarios == null || !Model.Comentarios.Any())
        {
            <p class="text-muted">
                Este libro aún no tiene comentarios.
            </p>
        }
        }

    </div>
</div>

<!-- BOTÓN VOLVER -->
<div class="mt-4">
    <a asp-action="Index"
       asp-controller="Libro"
       class="btn btn-secondary">
        Volver a la lista de libros
    </a>
</div>