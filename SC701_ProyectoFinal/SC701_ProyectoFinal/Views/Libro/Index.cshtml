@model IEnumerable<SC701_ProyectoFinal.Models.LibroModel>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">📚 Catálogo de Libros</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-success">➕ Agregar Libro</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped align-middle shadow-sm">
            <thead class="table-primary text-center">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>ISBN</th>
                    <th>Año</th>
                    <th>Estado</th>
                    <th>Imagen</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in Model)
                {
                    <tr>
                        <td class="text-center">@libro.Id_Libro</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.ISBN</td>
                        <td class="text-center">@libro.Anio</td>
                        <td>@libro.Estado_Libro</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(libro.Imagen_URL))
                            {
                                <img src="@libro.Imagen_URL" alt="Portada" width="50" height="70" class="rounded shadow-sm" />
                            }
                            else
                            {
                                <span class="text-muted">Sin imagen</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@libro.Id_Libro" class="btn btn-warning btn-sm">✏️ Editar</a>
                            <a asp-action="Delete" asp-route-id="@libro.Id_Libro" class="btn btn-danger btn-sm">🗑️ Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info text-center">
            No hay libros registrados en el sistema.
        </div>
    }

</div>
