@model List<SC701_ProyectoFinal.Models.FaqViewModel>

@{
    ViewData["Title"] = "Preguntas Frecuentes";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h2 class="mt-4">Preguntas Frecuentes</h2>

<div class="accordion mt-4" id="faqsAccordion">
    @foreach (var faq in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading@i">
                <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@i" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse@i">
                    @faq.Question
                </button>
            </h2>
            <div id="collapse@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading@i" data-bs-parent="#faqsAccordion">
                <div class="accordion-body">
                    @faq.Answer
                </div>
            </div>
        </div>
     }
</div>