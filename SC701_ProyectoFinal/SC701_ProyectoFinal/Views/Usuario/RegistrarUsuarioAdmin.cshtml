@model SC701_ProyectoFinal.Models.UsuarioModel

@{
    ViewData["Title"] = "RegistrarUsuarioAdmin";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary">
        <i class="bi bi-person-plus-fill"></i> Registrar Usuario
    </h2>
    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-primary text-center">
            @ViewBag.Mensaje
        </div>
    }

    <form asp-action="RegistrarUsuarioAdmin" asp-controller="Usuario" id="FormRegistrarUsuario" class="shadow p-4 rounded bg-white">

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Apellidos</label>
                <input asp-for="Apellidos" class="form-control" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Identificación</label>
                <input asp-for="Identificacion" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Correo</label>
                <input asp-for="Correo" class="form-control" />
            </div>
        </div>

        <div class="row mb-3">

            <div class="col-md-6">
                <label class="form-label fw-bold">Teléfono</label>
                <input asp-for="Telefono" class="form-control" />
            </div>
			<div class="col-md-6">
				<label class="form-label fw-bold">Rol</label>
                <select asp-for="Id_Rol" class="form-select" asp-items="ViewBag.Roles">
                    <option value="">Seleccione un rol</option>
                </select>

			</div>
        </div>

        

        <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-check-circle"></i> Guardar
        </button>

        <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>

    </form>
</div>

@section Scripts {
    <script src="~/js/AgregarUsuarioAdmin.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
