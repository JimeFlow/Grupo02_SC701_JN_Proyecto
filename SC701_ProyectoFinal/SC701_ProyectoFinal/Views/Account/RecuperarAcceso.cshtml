@model UsuarioModel
@{
	Layout = "_LayoutExterno";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-body p-4">

                <h3 class="text-center mb-4 fw-bold">Recuperar Acceso</h3>

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-info text-center rounded-3">
                        @ViewBag.Mensaje
                    </div>
                }

                <form id="formRecuperarAcceso" asp-action="RecuperarAcceso" asp-controller="Account" method="post">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correo electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control rounded-3" placeholder="usuario@correo.com" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                        Recuperar Acceso
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Regresar al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/RecuperarAcceso.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}