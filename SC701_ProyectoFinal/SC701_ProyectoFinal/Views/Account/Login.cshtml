@model SC701_ProyectoFinal.Models.UsuarioModel
@{
    ViewData["Title"] = "Iniciar sesión"; 
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}
<section class="py-0">
    <div class="container-fluid">
        <div class="row">

            <!-- Imagen lateral -->
            <div class="col-lg-6 px-0">
                <div class="sticky-top vh-lg-100 py-9">
                    <div class="bg-holder"
                         style="background-image:url('@Url.Content("~/lib/img/signin.jpg")');">
                    </div>
                </div>
            </div>

            <!-- Formulario -->
            <div class="col-lg-6 py-6">
                <div class="row h-100 align-items-center justify-content-center">
                    <div class="col-sm-8 col-md-6 col-lg-10 col-xl-8">

                        <h3 class="fw-bold mb-3">Bienvenido a la Biblioteca</h3>
                        <P class="text-muted mb-4">
                            Iniciá sesión con tus credenciales institucionales
                        </P>

                        @if (TempData["RegistroExitoso"] != null)
                        {
                            <div class="alert alert-success text-center mt-3">
                                @TempData["RegistroExitoso"]
                            </div>
                        }

                        <form asp-action="Login" asp-controller="Account" class="mt-5">

                            <div class="mb-3">
                                <label asp-for="Correo" class="form-label">Correo</label>
                                <input asp-for="Correo" class="form-control bg-light" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Contrasena" class="form-label">Contraseña</label>
                                <input asp-for="Contrasena" type="password" class="form-control bg-light" />
                            </div>

                            <div class="d-grid mb-3">
                                <button class="btn btn-dark btn-lg w-100">Iniciar sesión</button>
                            </div>

                            @Html.ValidationSummary("", new { @class = "text-danger" })
                        </form>

                        <div class="text-center">
                            <a asp-action="RecuperarAcceso" asp-controller="Account">
                                ¿Olvidó su contraseña?
                            </a>
                        </div>

                    </div>
                </div>
            </div>
    </div>
    </div>
</section>


@section Scripts {
    <script src="~/js/InicioSesion.js" asp-append-version="true"></script>
}
