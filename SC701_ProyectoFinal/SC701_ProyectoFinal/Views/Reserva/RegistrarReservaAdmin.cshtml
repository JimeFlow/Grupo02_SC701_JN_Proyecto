@model SC701_ProyectoFinal.Models.ReservaAdminViewModel
@{
	Layout = "_layoutInterno";
}

<div class="container mt-5">
	<h2 class="text-center mb-4">Registrar nueva reserva</h2>

    <div class="card shadow-lg">
        <div class="card-body">
            <form asp-action="RegistrarReservaAdmin" method="post">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Ejemplar</label>
                        <select class="form-select" asp-for="Id_Ejemplar"
                                asp-items="@(new SelectList(ViewBag.Ejemplares, "Id_Ejemplar", "TituloConId"))">
                            <option value="">Seleccione un ejemplar</option>
                        </select>
                    </div>                    
                </div>

                <div class="row mb-3">                    
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Usuario</label>
                        <select class="form-select" asp-for="Id_Usuario"
                                asp-items="@(new SelectList(ViewBag.Usuarios, "Id_Usuario", "NombreCompleto"))">
                            <option value="">Seleccione un usuario</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Fecha" class="form-label fw-bold">Fecha de inicio</label>
                        <input asp-for="Fecha" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Fecha_Vencimiento" class="form-label fw-bold">Fecha de vencimiento</label>
                        <input asp-for="Fecha_Vencimiento" class="form-control" type="date" />
                    </div>
                </div>                

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4">Guardar</button>
                    <a asp-action="ObtenerReservas" asp-controller="Reserva" class="btn btn-secondary px-4">Volver</a>
                </div>
            </form>
        </div>
    </div>

</div>