@model IEnumerable<SC701_ProyectoFinal.Models.EjemplarModel>

@{
    ViewData["Title"] = "Catálogo de Ejemplares";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Control de Ejemplares</h2>

    <div class="row my-3">
        <div class="col-6">
            <div class="text-start mb-3">
                <form method="get" asp-action="Index">
                    <div class="row align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Filtrar por estado</label>
                            <select name="estado" class="form-select w-100">
                                <option value="">Mostrar todos</option>
                                <option value="Disponible" selected="@(ViewBag.EstadoSeleccionado == "Disponible")">
                                    Disponible
                                </option>
                                <option value="Prestado" selected="@(ViewBag.EstadoSeleccionado == "Prestado")">
                                    Prestado
                                </option>
                                <option value="Dañado" selected="@(ViewBag.EstadoSeleccionado == "Dañado")">
                                    Dañado
                                </option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-primary">Filtrar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-6">
			<div class="text-end my-4">
				<a asp-action="Create" class="btn btn-success">Agregar Ejemplar</a>
			</div>
        </div>
    </div>


    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped shadow-sm align-middle">
            <thead class="table-primary text-center">
                <tr>
                    <th>ID</th>
                    <th>Código</th>
                    <th>Estado</th>
                    <th>Ubicación</th>
                    <th>Fecha Registro</th>
                    <th>Libro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="text-center">@e.Id_Ejemplar</td>
                        <td>@e.CodigoEjemplar</td>
                        <td>@e.Estado</td>
                        <td>@e.Ubicacion</td>
                        <td class="text-center">@e.Fecha_Registro.ToString("dd/MM/yyyy")</td>
                        <td>@e.Titulo</td>

                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@e.Id_Ejemplar" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Delete" asp-route-id="@e.Id_Ejemplar" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info text-center">No hay ejemplares registrados.</div>
    }
</div>