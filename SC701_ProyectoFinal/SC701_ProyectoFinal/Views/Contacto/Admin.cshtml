@model List<SC701_ProyectoFinal.Models.ContactoViewModel>

@{
    ViewData["Title"] = "Consultas de Contacto";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">
                <i class="bi bi-inbox-fill me-2"></i>
                Consultas Recibidas
            </h4>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No hay consultas registradas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Usuario</th>
                                <th>Correo</th>
                                <th>Asunto</th>
                                <th>Mensaje</th>
                                <th>Respuesta</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Nombre</td>
                                    <td>@item.Correo</td>
                                    <td>@item.Asunto</td>
                                    <td>@item.Mensaje</td>
                                    <td>
                                        @if ((item.Estado))
                                        {
                                            <span class="text-muted">Pendiente</span>
                                        }
                                        else
                                        {
                                            @item.Respuesta
                                        }
                                    </td>
                                    <td style="min-width: 360px;">
                                        @if (item.Estado)  // true = pendiente
                                        {
                                            <form asp-action="Responder" method="post">
                                                <input type="hidden" name="idContacto" value="@item.Id_Contacto" />

                                                <textarea name="respuesta"
                                              class="form-control mb-2"
                                              rows="4"
                                              placeholder="Escriba la respuesta"
                                              required></textarea>

                                                <button type="submit" class="btn btn-success btn-sm w-100">
                                                    Enviar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Respondido
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>