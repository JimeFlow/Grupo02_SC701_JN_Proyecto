@model IEnumerable<SC701_ProyectoFinal.Models.ReservaViewModel>
@* @model List<SC701_ProyectoFinal.Models.ReservaViewModel> *@

@{
    ViewData["Title"] = "MisReservas";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h2>Mis Reservas</h2>
<table class="table">
    <thead>
        <tr>
            <th>Libro</th>
            <th>Fecha Reserva</th>
            <th>Fecha de Expiración</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reserva in Model)
        {
            <tr>
                <td>@reserva.Titulo</td>
                <td>@reserva.FechaInicio.ToShortDateString()</td>
                <td>@reserva.FechaFin.ToShortDateString()</td>
                <td>@reserva.Estado_Libro</td>
            </tr>
        }
    </tbody>
</table>

